  export NODE_PATH="/proc/cygdrive/c/Users/theFoxCost/Documents/prjct(english)/node_modules/he/bin/node_modules:/proc/cygdrive/c/Users/theFoxCost/Documents/prjct(english)/node_modules/he/node_modules:/proc/cygdrive/c/Users/theFoxCost/Documents/prjct(english)/node_modules:/proc/cygdrive/c/Users/theFoxCost/Documents/node_modules:/proc/cygdrive/c/Users/theFoxCost/node_modules:/proc/cygdrive/c/Users/node_modules:/proc/cygdrive/c/node_modules:/proc/cygdrive/c/Users/theFoxCost/Documents/prjct(english)/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../he/bin/he" "$@"
else
